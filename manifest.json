{
  "schemaVersion": 1,
  "id": "bappoz.notch",
  "name": "Notchi for Omarchy",
  "version": "0.9.0",
  "author": "Bappoz; inspired by nannndev/OpenNotchi",
  "license": "MIT",
  "description": "A native dynamic island for Omarchy with media, calendar, files, focus and agents.",
  "kinds": [
    "service",
    "bar-widget",
    "panel"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Notch.qml",
    "panel": "DesktopOsd.qml"
  },
  "barWidget": {
    "displayName": "Notchi",
    "description": "Dynamic island inspired by OpenNotchi",
    "category": "System",
    "allowMultiple": false,
    "defaults": {
      "hoverDelay": 220,
      "theme": "glass",
      "animations": true,
      "animationStyle": "fluid",
      "islandScale": 100,
      "islandOffsetX": 0,
      "islandOffsetY": 0
    },
    "schema": [
      {
        "key": "hoverDelay",
        "type": "integer",
        "label": "Hover delay (ms)",
        "min": 100,
        "max": 1000,
        "defaultValue": 220
      },
      {
        "key": "theme",
        "type": "enum",
        "label": "Appearance",
        "options": [
          "glass",
          "midnight",
          "frosted"
        ],
        "defaultValue": "glass"
      },
      {
        "key": "animations",
        "type": "boolean",
        "label": "Animations",
        "defaultValue": true
      },
      {
        "key": "animationStyle",
        "type": "enum",
        "label": "Open animation",
        "options": [
          "fluid",
          "bouncy",
          "waterfall",
          "snappy",
          "pop",
          "gentle",
          "flip3D",
          "depth3D",
          "cube3D"
        ],
        "defaultValue": "fluid"
      },
      {
        "key": "islandScale",
        "type": "integer",
        "label": "Island size (%)",
        "min": 70,
        "max": 125,
        "defaultValue": 100
      },
      {
        "key": "islandOffsetX",
        "type": "integer",
        "label": "Island horizontal offset (px)",
        "min": -2000,
        "max": 2000,
        "defaultValue": 0
      },
      {
        "key": "islandOffsetY",
        "type": "integer",
        "label": "Island vertical offset (px)",
        "min": -200,
        "max": 200,
        "defaultValue": 0
      }
    ]
  },
  "keepLoaded": true,
  "omarchy": {
    "clonedFrom": "omarchy.osd"
  }
}
